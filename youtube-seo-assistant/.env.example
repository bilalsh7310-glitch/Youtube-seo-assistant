# Copy this file to ".env" and fill in your values.
# NEVER commit the real .env file or share your key.

# Required. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Overrides "default_model" in config.json (see https://openrouter.ai/models)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional. Sent to OpenRouter to identify your app. Use your real URL when deployed.
SITE_URL=http://localhost:5000
SITE_NAME=TubeRank AI

# Optional. Local port (Render sets PORT automatically).
PORT=5000

# Optional. Set to 1 for auto-reload while developing. Keep 0 in production.
FLASK_DEBUG=0
